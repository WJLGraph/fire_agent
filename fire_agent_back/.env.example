# ============================================================
# 焰哨多Agent与可视化平台 · 环境变量模板（P2#16 Docker 化交付）
# 使用：cp .env.example .env 后填入真实值
# ============================================================

# 运行环境：development | production
# 上线必须显式写成 production —— ENV=production 时 JWT 自检会硬拒绝弱密钥、
# 关闭 /docs /redoc /openapi.json，并改用 ADMIN_INIT_PASSWORD 播种管理员。
ENV=development

# JWT 签名密钥（必填，长度 ≥32 字节）
# 留空时开发环境会回退到一把公开常量并打告警，生产环境直接拒绝启动。
# 注意：模板里不允许提供可用的真实密钥，也不要沿用历史值——它已在 git 公开。
# 生成：python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET=

# 首次启动播种 admin 的口令（仅 ENV=production 生效；留空则跳过播种，
# 系统不会再用随机口令把明文打到 stdout）。密码学哈希入库，日志不打印明文。
ADMIN_INIT_PASSWORD=

# 允许跨源调用 API 的前端来源（逗号分隔，只写协议+域名，不要通配符 *）
# 例：CORS_ORIGINS=["https://your-domain"]
CORS_ORIGINS=["http://localhost:5173"]

# 数据库连接（docker compose 部署时无需修改，compose 会覆盖为 db 主机）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fire_agent

# 高德地图 Key（天气/定位/MCP 天气数据源，与前端一致）
AMAP_KEY=your_amap_key

# ---- LLM 提供商 ----
# 活跃 LLM 提供商（aliyun | amd | ollama），支持运行时热切换
ACTIVE_LLM_PROVIDER='aliyun'

# 阿里百炼（兼容 OpenAI 接口格式）
LLM_API_KEY=your_llm_api_key
LLM_API_BASE='https://dashscope.aliyuncs.com/compatible-mode/v1'
LLM_MODEL='qwen-plus'
# 向量模型（硬约束：恒定阿里百炼 text-embedding-v3，不随 LLM 提供商切换）
EMBEDDING_MODEL='text-embedding-v3'

# 视觉 / 语音模型（视觉可切换 aliyun/amd；语音恒定阿里百炼）
VISION_PROVIDER='aliyun'
VISION_MODEL='qwen-vl-plus'
ASR_MODEL='qwen3-asr-flash'
TTS_MODEL='qwen3-tts-flash'

# AMD GPU Cloud（可选，免费 DeepSeek-V4-Flash / 限时 Qwen3.8-Flash-Next）
# https://developer.amd.com.cn/radeon/tokenfactory?source=cherry-studio 获取 API Key
AMD_API_KEY=your_amd_api_key
AMD_API_BASE='https://developer.amd.com.cn/radeon/v1'
AMD_MODEL='DeepSeek-V4-Flash'

# 本地 Ollama（可选，无需 API Key）
OLLAMA_API_BASE='http://localhost:11434/v1'
OLLAMA_MODEL='qwen2.5:7b'

# Qwen3.8-Flash-Next 可用时间窗口（空表示不限，格式: YYYY-MM-DD HH:MM:SS）
QWEN3_8_FLASH_START=
QWEN3_8_FLASH_END=

# ---- 知识库 / RAG ----
KB_CHUNK_SIZE='500'
KB_CHUNK_OVERLAP='50'
KB_TOP_K='5'
# Rerank 精排（阿里 DashScope text-rerank，使用 LLM_API_KEY；失败自动降级 RRF 融合）
RERANK_ENABLED=true
RERANK_MODEL='qwen3-rerank'

# ---- Agent 参数（P1）----
# 报告生成后需人工审批（HITL）才定稿
AGENT_REQUIRE_APPROVAL=true

# ---- P2 功能开关 ----
# 全链路流式输出（报告/RAG 回答逐字推送；关闭后回退整段返回）
LLM_STREAM_ENABLED=true
# 用户偏好长期记忆（PostgresStore，ReportAgent 注入；关闭后不读写偏好）
PREFERENCES_ENABLED=true
# MCP 工具化数据源（高德天气只读 server；依赖缺失或调用失败自动降级跳过）
MCP_ENABLED=true

# Langfuse 私有化观测（docker compose --profile observability up -d 拉起服务）
# 部署后在 Langfuse 控制台创建项目获取公钥/密钥；未启用或未配密钥时降级纯日志
LANGFUSE_ENABLED=false
LANGFUSE_HOST='http://localhost:3000'
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---- 报告署名（自动追加到每份生成报告末尾）----
# REPORT_FOOTER 由 app/core/config.py 提供默认值，如需自定义再打开：
# REPORT_FOOTER="\n\n---\n\n> **系统与开发者信息**\n> - 系统名称：焰哨多Agent与可视化平台\n> - 开发者：wjl\n> - 联系邮箱：19136220923@163.com\n"
